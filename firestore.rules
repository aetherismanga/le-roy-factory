rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : "";
    }

    function isAgent() {
      return isSignedIn() && (
        email() == "jerome@leroyfactory.fr" ||
        email() == "coryne@leroyfactory.fr" ||
        request.auth.token.role == "agent" ||
        request.auth.token.role == "admin"
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        email() == "jerome@leroyfactory.fr" ||
        request.auth.token.role == "admin"
      );
    }

    // Données CRM : aucun accès anonyme. Les Cloud Functions utilisent l'Admin SDK
    // et ne sont pas soumises à ces règles.
    match /clients/{document=**} {
      allow read, write: if isAgent();
    }

    match /historique_mails/{document=**} {
      allow read, write: if isAgent();
    }

    match /account_requests/{document=**} {
      allow read, write: if isAgent();
    }

    match /scheduled_mails/{document=**} {
      allow read, write: if isAgent();
    }

    match /comptes_rendus/{document=**} {
      allow read, write: if isAgent();
    }

    match /agenda/{document=**} {
      allow read, write: if isAgent();
    }

    match /settings/{document=**} {
      allow read: if isAgent();
      allow write: if isAdmin();
    }

    // Collections techniques : écriture uniquement par Admin SDK serveur.
    match /rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /audit_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /jarvis_audit/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pro_sessions/{document=**} {
      allow read, write: if false;
    }

    match /pro_login_challenges/{document=**} {
      allow read, write: if false;
    }

    // Tout ce qui n'est pas explicitement prévu est fermé aux anonymes et
    // accessible aux agents authentifiés pour préserver les modules CRM existants.
    match /{document=**} {
      allow read, write: if isAgent();
    }
  }
}
