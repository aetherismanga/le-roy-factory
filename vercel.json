{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shared/avatar/:path*",
      "destination": "https://maison-3d-leroyfactory-hugol-trading.vercel.app/assets/avatar/:path*"
    }
  ],
  "functions": {
    "api/projects.js": {
      "maxDuration": 60
    }
  }
}
