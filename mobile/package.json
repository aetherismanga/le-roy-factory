{
  "name": "le-roy-factory-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Application mobile officielle LE ROY FACTORY pour Android, iPhone et iPad",
  "scripts": {
    "prepare:web": "node scripts/sync-web.mjs",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "patch:android": "node scripts/patch-android-google.mjs",
    "patch:alarm": "node scripts/patch-android-alarm.mjs",
    "cap:sync": "npm run prepare:web && npx cap sync android && npm run patch:android && npm run patch:alarm",
    "cap:sync:ios": "npm run prepare:web && npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android": "npm run cap:sync && npm run cap:open",
    "ios": "npm run cap:sync:ios && npm run cap:open:ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
