{
  "name": "le-roy-factory-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Application Android officielle LE ROY FACTORY",
  "scripts": {
    "prepare:web": "node scripts/sync-web.mjs",
    "cap:add:android": "npx cap add android",
    "patch:android": "node scripts/patch-android-google.mjs",
    "cap:sync": "npm run prepare:web && npx cap sync android && npm run patch:android",
    "cap:open": "npx cap open android",
    "android": "npm run cap:sync && npm run cap:open"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
