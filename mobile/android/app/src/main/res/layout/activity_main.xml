<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">
    <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/lrf_logo" android:contentDescription="@string/app_name" android:scaleType="fitCenter"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/app_name" android:textSize="24sp" android:letterSpacing="0.08" android:textColor="@color/ink"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/brand_subtitle" android:textSize="11sp" android:textColor="@color/muted"/>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="64dp" android:text="@string/welcome_title" android:textSize="30sp" android:textColor="@color/ink"/>
    <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/loading" android:textSize="17sp" android:lineSpacingExtra="5dp" android:textColor="@color/muted"/>
    <Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="32dp" android:text="@string/retry" android:visibility="gone"/>
</LinearLayout>
</ScrollView>
